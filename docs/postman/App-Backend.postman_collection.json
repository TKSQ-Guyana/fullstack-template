{
  "info": {
    "name": "App Backend",
    "description": "The exerciser for the template's API. MAINTAINED PAIRWISE with backend/src/docs/openapi.yaml — any route/param/contract change updates both in the same commit.\n\nSign in first (Auth → Login): the backend answers HttpOnly cookies and Postman's cookie jar carries them on every later call to the same host. Seeded dev accounts: admin@example.dev / manager@example.dev / user@example.dev with the APP_DEV_PASSWORD from your .env.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api/v1" },
    { "key": "serverRoot", "value": "http://localhost:8081" },
    { "key": "username", "value": "manager@example.dev" },
    { "key": "password", "value": "" },
    { "key": "noteId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{serverRoot}}/health",
            "description": "Root-mounted, outside the base paths. DB is the only hard dependency."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "description": "Sets the HttpOnly session cookies; the response carries the verified claims, never a token."
          }
        },
        {
          "name": "GET /auth/session",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/session" }
        },
        {
          "name": "POST /auth/refresh",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/refresh" }
        },
        {
          "name": "POST /auth/logout",
          "request": { "method": "POST", "url": "{{baseUrl}}/auth/logout" }
        }
      ]
    },
    {
      "name": "Me",
      "item": [
        {
          "name": "GET /me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/me",
            "description": "Identity + the effective permissions map the UI drives show/hide from."
          }
        }
      ]
    },
    {
      "name": "Notes (example feature)",
      "item": [
        {
          "name": "GET /notes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/notes?q=&limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["notes"],
              "query": [
                { "key": "q", "value": "" },
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "POST /notes",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('noteId', pm.response.json().noteId)",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/notes",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"First note\",\n  \"body\": \"Written from Postman.\",\n  \"tags\": [\"demo\"],\n  \"actionUuid\": \"{{$guid}}\"\n}"
            },
            "description": "MANAGER/ADMIN only — sign in as user@example.dev to see the 403. actionUuid demonstrates replay protection."
          }
        },
        {
          "name": "GET /notes/:noteId",
          "request": { "method": "GET", "url": "{{baseUrl}}/notes/{{noteId}}" }
        },
        {
          "name": "PATCH /notes/:noteId",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/notes/{{noteId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"body\": \"Edited from Postman.\"\n}"
            }
          }
        },
        {
          "name": "DELETE /notes/:noteId",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/notes/{{noteId}}" }
        }
      ]
    },
    {
      "name": "Accounts (invitations)",
      "item": [
        {
          "name": "GET /accounts/password-invitations",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/password-invitations",
            "description": "Needs manage-users on the caller's own token (sign in as admin@example.dev)."
          }
        },
        {
          "name": "POST /accounts/:kcUserId/password-email",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/accounts/REPLACE-KC-USER-ID/password-email",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"purpose\": \"provision\"\n}" },
            "description": "The dev stack delivers into Mailpit at http://localhost:8025."
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "POST /document/upload",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/document/upload",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "folder", "value": "app/uploads/demo", "type": "text" },
                { "key": "comment", "value": "uploaded from Postman", "type": "text" }
              ]
            },
            "description": "Needs the dms compose profile (or DMS_ENABLED with a reachable Mayan); otherwise answers a placeholder DOC- reference."
          }
        },
        {
          "name": "GET /document/list",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/document/list?folder=app/uploads/demo",
              "host": ["{{baseUrl}}"],
              "path": ["document", "list"],
              "query": [{ "key": "folder", "value": "app/uploads/demo" }]
            }
          }
        },
        {
          "name": "GET /document/view",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/document/view?docId=DOC-1",
              "host": ["{{baseUrl}}"],
              "path": ["document", "view"],
              "query": [
                { "key": "docId", "value": "DOC-1" },
                { "key": "meta", "value": "true", "disabled": true }
              ]
            }
          }
        }
      ]
    }
  ]
}

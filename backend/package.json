{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "API backend — Express 5 / TypeScript over Postgres in MVC layers (controllers → services → domain + repositories → presenters), Keycloak cookie sessions.",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --mode db",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down",
    "migrate:status": "node scripts/migrate.mjs status",
    "db:types": "kysely-codegen --dialect postgres --date-parser string --include-pattern \"app.*\" --out-file src/db/schema.generated.ts",
    "db:types:check": "kysely-codegen --dialect postgres --date-parser string --include-pattern \"app.*\" --out-file src/db/schema.generated.ts --verify",
    "smoke": "node scripts/smoke.mjs",
    "docs:lint": "npx --yes @redocly/cli@latest lint src/docs/openapi.yaml",
    "pre-push-check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "lint-staged": {
    "*.{ts,mts,cts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@simplewebauthn/server": "^10.0.1",
    "@simplewebauthn/types": "^10.0.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "kysely": "^0.28.18",
    "multer": "^2.0.1",
    "nodemailer": "^9.1.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.2.0",
    "swagger-ui-dist": "^5.29.0",
    "undici": "^8.10.0",
    "ws": "^8.21.3",
    "yaml": "^2.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.4",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-dist": "^3.30.5",
    "@types/ws": "^8.18.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "kysely-codegen": "^0.18.5",
    "lint-staged": "^16.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "supertest": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.0.0"
  }
}

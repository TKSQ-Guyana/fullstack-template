# Mail into the DEV STACK'S MAILPIT SINK — committed on purpose: there is no
# secret here and nothing leaves the machine. The compose file loads this
# FIRST and the gitignored backend/.env.mail SECOND, so a real relay
# credential overrides the sink key by key.
MAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# Mailpit offers no TLS; the exception the mailer's requireTLS carve-out
# exists for (see src/services/mailer.ts). Never set this against a relay a
# credential crosses the wire to.
SMTP_ALLOW_PLAINTEXT=true
MAIL_FROM=App Portal <no-reply@app.local>
# The delivery wall: the sink accepts everything and delivers nothing, so
# open delivery here is safe — and it is what lets every generated mail be
# read at http://localhost:8025.
MAIL_RECIPIENT_ALLOWLIST=*

# ═══════════════════════════════════════════════════════════════════════════
# Backend environment — COMPLETE reference. Every variable src/config/env.ts
# reads appears here with its default; copy to .env for `npm run dev`.
# Every value has a default, so an empty .env boots against the dev stack.
# ═══════════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# Display name — mail subjects/bodies and the MFA relying-party name.
APP_NAME=App Portal
PORT=8081
# Every base path serves the same API: /app/v1 for the frontend proxy,
# /api/v1 for direct callers. Changing the FIRST one requires rebuilding the
# backend image (the MFA UI bakes it into its asset paths).
BASE_PATHS=/app/v1,/api/v1
CORS_ORIGINS=*
JSON_BODY_LIMIT=10mb
UPLOAD_MAX_MB=25
LOG_LEVEL=info
# pretty for a human terminal, json for anything aggregated.
LOG_FORMAT=pretty

# ── Database (the one hard dependency) ──────────────────────────────────────
# Default matches the dev stack: compose Postgres publishes on HOST port 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app_db
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000

# ── Auth / Keycloak ─────────────────────────────────────────────────────────
# enforce = 401 without a valid token/cookie (production posture).
# optional = missing token falls back to ?role=&tenantId=&actor= (dev tooling;
#            RBAC only bites on verified identities).
# disabled = query identity only.
AUTH_MODE=enforce
KC_URL=http://localhost:8085
KC_REALM=app-realm
# Set when browsers and this backend reach Keycloak at DIFFERENT addresses:
# it must equal the issuer the browsers' tokens carry.
KC_ISSUER=
KC_AUDIENCE=
# The public SPA client the password grant runs against (Direct Access Grants
# ON; no secret exists).
KC_CLIENT_ID=web-app
# true when the app is served over https. A Secure cookie over plain http
# silently never comes back.
AUTH_COOKIE_SECURE=false
# The confidential service account: boot-time realm ensure, set-password
# writes, MFA phone lookups. Needs realm-management grants view-realm,
# view-users, manage-realm, manage-users. The dev realm's secret is
# dev-provisioning-secret; REGENERATE it for any deployment.
KC_SERVICE_CLIENT_ID=app-provisioning-service
KC_SERVICE_CLIENT_SECRET=

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ── Redis (optional; off = in-memory rate limit + DB idempotency) ───────────
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# ── MFA / WebAuthn (src/mfa) ────────────────────────────────────────────────
# The three that must agree, naming the origin the phone's BROWSER sees.
MFA_RP_ID=localhost
MFA_ORIGINS=http://localhost:3000,http://localhost:5173
MFA_PUBLIC_URL=http://localhost:3000
# Where the built phone UI lives inside the image (Dockerfile sets it).
MFA_UI_DIR=mfa-ui
# The advisory desktop refusal. Default ON; the dev stack sets false so a
# laptop can walk the flow. The same-browser refusal is always on.
MFA_REQUIRE_MOBILE=true
# Which Keycloak USER ATTRIBUTE holds the mobile number. NOTE: Keycloak 26
# silently drops attributes the realm's user profile does not declare.
MFA_PHONE_ATTRIBUTE=mobile

# ── SMS (the approval link by text; off unless configured) ──────────────────
SMS_ENABLED=false
SMS_API_URL=https://api.sms-gate.app/3rdparty/v1/message
SMS_USERNAME=
SMS_PASSWORD=
SMS_TIMEOUT_MS=8000
# {link} is substituted; keep each to one GSM-7 segment (160 chars).
MFA_SMS_TEMPLATE=App sign-in: approve (3 min, one use):\n{link}\nNot you? Ignore.
MFA_ENROL_SMS_TEMPLATE=App: register this phone for sign-in approval:\n{link}\nNot you? Tell IT.

# ── Outbound email (off unless configured; delivery CLOSED by default) ──────
MAIL_ENABLED=false
SMTP_HOST=
# 587 + SMTP_SECURE=false = STARTTLS; 465 + true = implicit TLS. Getting this
# backwards HANGS the connection rather than failing it.
SMTP_PORT=587
SMTP_SECURE=false
# Permit a relay with NO TLS at all. For the dev stack's Mailpit sink ONLY —
# never where a credential crosses the wire.
SMTP_ALLOW_PLAINTEXT=false
SMTP_USER=
SMTP_PASSWORD=
# Empty falls back to SMTP_USER (Gmail rewrites a From it does not own).
MAIL_FROM=
MAIL_REPLY_TO=
# THE DELIVERY WALL — set exactly one per environment, or every recipient is
# refused: redirect everything to one test inbox, or allowlist who this
# environment may mail (@domain suffixes, full addresses, or * for open).
MAIL_REDIRECT_TO=
MAIL_RECIPIENT_ALLOWLIST=
MAIL_TIMEOUT_MS=10000
# Where links in mail point — the origin the RECIPIENT's browser can reach.
APP_PUBLIC_URL=http://localhost:3000
# How long a set-password link stays usable.
PASSWORD_INVITE_TTL_HOURS=72

# ── Document store (Mayan EDMS; off = placeholder mode) ─────────────────────
DMS_ENABLED=false
DMS_URL=
DMS_USERNAME=
DMS_PASSWORD=
DMS_DOCUMENT_TYPE=Default
# Skip TLS verification on the DMS hop ONLY (internal-CA certificates).
DMS_TLS_INSECURE=false

# ── API docs (Swagger UI at <base>/docs/) ───────────────────────────────────
# Deliberately not gated on NODE_ENV — the image hardcodes production.
API_DOCS_ENABLED=false

# The full gate per workspace: lint + format:check + typecheck + test + build.
# Same set CI runs — a push that passes here should not fail CI.
# NOTE for Windows/PowerShell users: hooks print progress to stderr, so the
# output shows red even on SUCCESS. Trust the exit code, not the colour.
[ -d node_modules ] || exit 0
for ws in backend frontend mfa-ui; do
  if [ -f "$ws/package.json" ]; then
    (cd "$ws" && npm run pre-push-check --if-present)
  fi
done

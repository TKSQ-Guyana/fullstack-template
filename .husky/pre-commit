# Lint + format only the files in this commit, then re-stage the fixes.
# lint-staged runs per workspace so each ignores staged files outside it.
# Workspaces hoist dependencies to the ROOT node_modules, so that is the
# installed-ness check; npx resolves bins through the parent automatically.
# A workspace is skipped until it declares a "lint-staged" block in its
# package.json (that is where this repo keeps the config).
# The full lint/format/typecheck/test/build sweep runs in pre-push.
[ -d node_modules ] || exit 0
for ws in backend frontend mfa-ui; do
  if [ -f "$ws/package.json" ] && grep -q '"lint-staged"' "$ws/package.json"; then
    (cd "$ws" && npx lint-staged)
  fi
done

{
  "name": "fullstack-template",
  "version": "0.1.0",
  "private": true,
  "description": "Fork-and-start full-stack TypeScript template: Express 5 + Postgres SQL functions, React + Vite, Keycloak cookie auth, one-command docker dev stack.",
  "workspaces": [
    "backend",
    "frontend",
    "mfa-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7"
  }
}

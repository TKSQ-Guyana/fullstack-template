#!/bin/sh
# Default KC_INTERNAL_URL to KC_URL, before nginx fills in its config template.
#
# KC_URL does two jobs that are not always the same job: it is the Keycloak
# address the BROWSER uses (written into /config.js, so it must be the public
# edge), and the address NGINX IN THIS CONTAINER dials for the /kcadmin proxy.
# Those calls are server-to-server, and from inside the infrastructure the
# public edge may only be reachable out through the CDN and back in — the
# hairpin leg that 502s. So the template dials ${KC_INTERNAL_URL}, and a
# deployment sets it to Keycloak's inside address when needed.
#
# THE DEFAULT IS WHAT MAKES THIS SAFE TO SHIP. envsubst replaces an unset
# variable with an empty string, which renders `proxy_pass /realms/...` — an
# "invalid URL prefix" parse error, i.e. a container that refuses to start on
# every deployment that never heard of the variable. Defaulting to KC_URL
# keeps those deployments exactly as they were.
#
# `.envsh`, not `.sh`, load-bearing: the official nginx entrypoint SOURCES
# `*.envsh`, which is what lets this export reach 20-envsubst-on-templates.sh.
# The 12- prefix places it after the image's own 10- script and before that
# substitution step.

set -eu

if [ -n "${KC_INTERNAL_URL:-}" ]; then
  echo "12-kc-internal-url.envsh: nginx will reach Keycloak at KC_INTERNAL_URL=${KC_INTERNAL_URL}."
else
  KC_INTERNAL_URL="${KC_URL:-}"
  echo "12-kc-internal-url.envsh: KC_INTERNAL_URL is not set; nginx will reach Keycloak at KC_URL=${KC_INTERNAL_URL} — fine only if this container can reach that address from inside."
fi

export KC_INTERNAL_URL

{
  "realm": "app-realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "APP_ADMIN",
        "description": "Administers accounts, reference data and settings."
      },
      {
        "name": "APP_MANAGER",
        "description": "Writes domain data (the notes example)."
      },
      {
        "name": "APP_USER",
        "description": "Reads."
      }
    ]
  },
  "clients": [
    {
      "clientId": "web-app",
      "name": "Web application",
      "description": "The SPA client. PUBLIC with Direct Access Grants: the BACKEND runs the password grant on the browser's behalf (/auth/login) — no secret exists.",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "webOrigins": ["http://localhost:5173", "http://localhost:3000"],
      "redirectUris": ["http://localhost:5173/*", "http://localhost:3000/*"],
      "protocolMappers": [
        {
          "name": "app_roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "app_roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "true"
          }
        },
        {
          "name": "tenant_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_name",
            "claim.name": "tenant_name",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "aggregate.attrs": "true"
          }
        }
      ]
    },
    {
      "clientId": "app-provisioning-service",
      "name": "Provisioning service account",
      "description": "CONFIDENTIAL client whose service account the backend uses for boot-time realm ensure and server-side user lookups. The secret below is the LOCAL DEV value — a deployed realm regenerates it and grants the realm-management roles by hand (view-realm, view-users, manage-realm, manage-users).",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-provisioning-secret",
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true
    }
  ]
}

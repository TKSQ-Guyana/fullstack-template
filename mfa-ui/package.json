{
  "name": "mfa-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The phone-facing MFA pages (/enroll, /verify) — built into the backend image and served at <base>/mfa/*.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pre-push-check": "npm run lint && npm run format:check && npm run build"
  },
  "lint-staged": {
    "*.{ts,mts}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{js,mjs,json,md,html,css}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vite": "^6.0.0"
  }
}

# Copy me to `.env` at the repo root — docker compose reads it for
# interpolation. Everything here is LOCAL DEV configuration; nothing in this
# file should ever describe a deployed environment.

# The one required value: the password every seeded demo account gets
# (admin@example.dev, manager@example.dev, user@example.dev). Choose your own;
# the compose file refuses to start the seeder without it.
APP_DEV_PASSWORD=

# Optional overrides — see docker-compose.dev.yml for the full ${APP_*} list.
# APP_NAME=My Product
# APP_AUTH_MODE=enforce
# APP_MFA_ENABLED=true          # exercise the second factor at :3000
# APP_DMS_ENABLED=true          # with: docker compose --profile dms up -d
# APP_MAYAN_PASSWORD=mayan-dev-pass

# Host ports, when another stack already holds the defaults. The issuer, CORS
# and mail-link origins follow these automatically.
# APP_FRONTEND_PORT=3000
# APP_BACKEND_PORT=8081
# APP_KC_PORT=8085
# APP_PG_PORT=5433
# APP_MAILPIT_PORT=8025
# APP_SMTP_PORT=1025
# APP_MAYAN_PORT=8888
